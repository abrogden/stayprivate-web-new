  }

  .pricing-card ul {
    display: grid;
    gap: .65rem;
    margin: 1.3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pricing-card li {
    position: relative;
    padding-left: 1.45rem;
    color: var(--sp-muted);
    line-height: 1.5;
  }

  .pricing-card li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--sp-blue);
    font-weight: 700;
  }

  .capacity-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .75rem;
    margin: 1.15rem 0 1.35rem;
  }

  .capacity-pair > div {
    display: grid;
    gap: .2rem;
    padding: 1rem;
    border: 1px solid var(--sp-border);
    border-radius: 16px;
    background: var(--sp-bg);
