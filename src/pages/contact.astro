---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";

const contactAction = withBase("/php/contact.php");
---

<BaseLayout
  title="Contact StayPrivate"
  description="Talk to StayPrivate about Documentd, Bespoke secure communication solutions, Keepd or an existing StayPrivate platform."
>
  <main class="sp-home">

    <section class="sp-hero">
      <div class="sp-container bespoke-contact-grid">

        <!-- Intro -->
        <div>

          <p class="sp-kicker">
            Contact
          </p>

          <h1>
            Let's talk
          </h1>

          <p class="sp-hero-intro">
            Talk to us about delivering important documents, specialist secure
            communication, or how customer ownership can form part of the
            way you communicate with the people you serve.
          </p>


          <div class="contact-options-card">

            <p class="contact-options-kicker">
              We can help with
            </p>

            <div class="contact-options">

              <div>
                <strong>
                  Documentd
                </strong>

                <span>
                  Deliver important documents and give customers their own
                  copy to keep.
                </span>
              </div>


              <div>
                <strong>
                  Bespoke
                </strong>

                <span>
                  Secure email, file sharing and tailored communication
                  solutions.
                </span>
              </div>


              <div>
                <strong>
                  Keepd
                </strong>

                <span>
                  A free private place for individuals, and the customer
                  ownership layer behind Documentd.
                </span>
              </div>

            </div>

          </div>


          <div class="contact-existing">

            <p class="contact-existing__kicker">
              Already work with StayPrivate?
            </p>

            <p>
              We also support existing StayPrivate platforms and can help with
              changes, integrations and evolving requirements.
            </p>

            <a
              href="https://admin.stayprivate.com"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open admin portal
              <span>→</span>
            </a>

          </div>

        </div>


        <!-- Contact form -->
        <form
          class="bespoke-form"
          action={contactAction}
          method="post"
          data-contact-form
        >

          <label>
            Name

            <input
              type="text"
              name="name"
              autocomplete="name"
              required
            />
          </label>


          <label>
            Email

            <input
              type="email"
              name="email"
              autocomplete="email"
              required
            />
          </label>


          <label>
            <span data-word="Organization">
              Organisation
            </span>

            <input
              type="text"
              name="organisation"
              autocomplete="organization"
            />
          </label>


          <label class="custom-select-label">

            How can we help?

            <input
              type="hidden"
              name="interest"
              id="interestInput"
            />

            <div
              class="custom-select"
              data-custom-select
            >

              <button
                type="button"
                class="custom-select-trigger"
                aria-haspopup="listbox"
                aria-expanded="false"
              >
                <span>
                  Select an option
                </span>

                <span
                  class="custom-select-arrow"
                  aria-hidden="true"
                ></span>
              </button>


              <div
                class="custom-select-menu"
                role="listbox"
              >

                <button
                  type="button"
                  role="option"
                  data-value="documentd"
                >
                  Documentd
                </button>

                <button
                  type="button"
                  role="option"
                  data-value="bespoke"
                >
                  Bespoke
                </button>

                <button
                  type="button"
                  role="option"
                  data-value="keepd"
                >
                  Keepd
                </button>

                <button
                  type="button"
                  role="option"
                  data-value="support"
                >
                  Existing StayPrivate platform
                </button>

                <button
                  type="button"
                  role="option"
                  data-value="other"
                >
                  Something else
                </button>

              </div>

            </div>

            <span
              class="custom-select-error"
              data-interest-error
              hidden
            >
              Please select an option.
            </span>

          </label>


          <label>
            Message

            <textarea
              name="message"
              rows="8"
              required
            ></textarea>
          </label>


          <input
            type="hidden"
            name="source"
            value="contact-page"
          />


          <button
            type="submit"
            class="sp-btn sp-btn-primary"
          >
            Send message
          </button>

        </form>

      </div>
    </section>

  </main>


  <script>
    const form =
      document.querySelector<HTMLFormElement>(
        "[data-contact-form]"
      );

    const select =
      document.querySelector<HTMLElement>(
        "[data-custom-select]"
      );

    const input =
      document.querySelector<HTMLInputElement>(
        "#interestInput"
      );

    const error =
      document.querySelector<HTMLElement>(
        "[data-interest-error]"
      );


    if (select && input) {

      const trigger =
        select.querySelector<HTMLButtonElement>(
          ".custom-select-trigger"
        );

      const triggerText =
        trigger?.querySelector<HTMLSpanElement>(
          "span:first-child"
        );

      const menu =
        select.querySelector<HTMLElement>(
          ".custom-select-menu"
        );


      const closeSelect = () => {
        select.classList.remove("open");

        trigger?.setAttribute(
          "aria-expanded",
          "false"
        );
      };


      trigger?.addEventListener("click", () => {
        const isOpen =
          select.classList.toggle("open");

        trigger.setAttribute(
          "aria-expanded",
          String(isOpen)
        );
      });


      menu
        ?.querySelectorAll<HTMLButtonElement>(
          "button[data-value]"
        )
        .forEach((option) => {

          option.addEventListener(
            "click",
            () => {

              input.value =
                option.dataset.value ?? "";

              if (triggerText) {
                triggerText.textContent =
                  option.textContent?.trim() ??
                  "Select an option";
              }

              menu
                .querySelectorAll(
                  '[role="option"]'
                )
                .forEach((item) => {
                  item.setAttribute(
                    "aria-selected",
                    "false"
                  );
                });

              option.setAttribute(
                "aria-selected",
                "true"
              );

              if (error) {
                error.hidden = true;
              }

              closeSelect();
            }
          );

        });


      document.addEventListener(
        "click",
        (event) => {

          if (
            event.target instanceof Node &&
            !select.contains(event.target)
          ) {
            closeSelect();
          }

        }
      );


      document.addEventListener(
        "keydown",
        (event) => {

          if (
            event.key === "Escape" &&
            select.classList.contains("open")
          ) {
            closeSelect();
            trigger?.focus();
          }

        }
      );

    }


    form?.addEventListener(
      "submit",
      (event) => {

        /*
         * A hidden input is not subject to normal
         * HTML required-field validation, so validate
         * the custom select explicitly.
         */
        if (!input?.value) {

          event.preventDefault();

          if (error) {
            error.hidden = false;
          }

          select?.scrollIntoView({
            behavior: "smooth",
            block: "center",
          });

          select
            ?.querySelector<HTMLButtonElement>(
              ".custom-select-trigger"
            )
            ?.focus();

        }

      }
    );
  </script>

</BaseLayout>


<style>

  /* Product / enquiry options */

  .contact-options-card {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .contact-options-kicker {
    margin: 0 0 1rem;
    color: var(--color-text-secondary, #5f6470);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .contact-options {
    display: grid;
  }

  .contact-options > div {
    display: grid;
    gap: 0.35rem;
    padding-block: 1.15rem;
    border-top:
      1px solid
      rgb(20 25 35 / 10%);
  }

  .contact-options > div:first-child {
    border-top: 0;
  }

  .contact-options strong {
    color: var(--color-text-primary, #17191f);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .contact-options span {
    max-width: 520px;
    color: var(--color-text-secondary, #5f6470);
    font-size: 0.875rem;
    line-height: 1.55;
  }


  /* Existing customers */

  .contact-existing {
    display: grid;
    gap: 0.6rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    border-radius: 18px;
    background: #f5f5f7;
    padding: 1.5rem;
  }

  .contact-existing__kicker {
    margin: 0;
    color: var(--color-text-primary, #17191f);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .contact-existing
    > p:not(.contact-existing__kicker) {
    margin: 0;
    color: var(--color-text-secondary, #5f6470);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .contact-existing a {
    justify-self: start;
    margin-top: 0.2rem;
    font-size: 0.825rem;
    font-weight: 700;
    text-decoration: none;
  }

  .contact-existing a:hover {
    text-decoration: underline;
  }


  /* Custom select validation */

  .custom-select-error {
    display: block;
    margin-top: 0.5rem;
    color: #a32929;
    font-size: 0.8rem;
    line-height: 1.4;
  }

  .custom-select-error[hidden] {
    display: none;
  }

</style>