---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About | StayPrivate"
  description="StayPrivate provides secure products and bespoke solutions for document delivery, storage and communication."
>
  <main class="sp-home">
    <section class="sp-hero">
      <div class="sp-container bespoke-grid">
        <div>
          <p class="sp-kicker">About StayPrivate</p>

          <h1>Making important information easier to manage</h1>

          <p class="sp-hero-intro">
            For more than 10 years, StayPrivate has helped
            <span data-word="organizations">organisations</span> communicate,
            share and manage information securely. Today that experience powers
            Documentd, Keepd and our bespoke solutions.
          </p>
        </div>

        <aside class="bespoke-panel about-panel">
          <p class="panel-kicker">Experience</p>

          <h2>
            Trusted by <span data-word="organizations">organisations</span> for
            secure communication
          </h2>

          <div class="about-product-list">
            <div>
              <strong>10+ years</strong>
              <span>
                Helping <span data-word="organizations">organisations</span>
                communicate and manage information securely.
              </span>
            </div>

            <div>
              <strong>
                1,000+ <span data-word="organizations">organisations</span> supported
              </strong>
              <span>
                Across document delivery, private communication and information
                management.
              </span>
            </div>

            <div>
              <strong>Documentd, Keepd and Bespoke</strong>
              <span>
                Three complementary ways to solve secure communication challenges.
              </span>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="about-section">
      <div class="sp-container about-grid">
        <div>
          <p class="sp-kicker">Our mission</p>
          <h2>Secure communication should be simple</h2>
        </div>

        <div class="about-copy">
          <p>
            Important information is increasingly sent and received online, but the
            experience is often fragmented. Email is convenient but messy.
            Traditional portals can be costly to manage and awkward for customers.
            Secure file sharing can feel too technical for everyday use.
          </p>

          <p>
            StayPrivate brings secure delivery, storage and communication into
            clearer, more usable systems for both
            <span data-word="organizations">organisations</span> and the people
            they serve.
          </p>
        </div>
      </div>
    </section>

    <section class="about-section">
      <div class="sp-container about-grid">
        <div>
          <p class="sp-kicker">Our approach</p>
          <h2>
            Better for <span data-word="organizations">organisations</span> and
            the people they serve
          </h2>
        </div>

        <div class="about-copy">
          <p>
            StayPrivate's products are designed around a simple idea: secure
            communication works best when it benefits both sides.
          </p>

          <p>
            <span data-word="Organizations">Organisations</span> need reliable
            ways to deliver important information. People need straightforward ways
            to access, <span data-word="organize">organise</span> and find it
            again later. That thinking shapes Documentd, Keepd and our bespoke
            solutions.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>