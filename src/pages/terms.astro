          <aside class="dd-legal-sidebar">
            <p>On this page</p>
            <a href="#terms">Terms of Service</a>
            <a href="#privacy">Privacy Policy</a>
            <a href="#compliance">Compliance Policy</a>
            <a href="#acceptable-use">Acceptable Use</a>
