---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";

const spmHref = withBase("/stayprivatemail");
const secureCommHref = withBase("/secure-comm");
const bespokeHref = withBase("/bespoke");
const contactHref = withBase("/contact");
---

<BaseLayout
  title="StayPrivate | Secure communication between businesses and customers"
  description="StayPrivate provides Documentd for important document delivery, StayPrivateMail for private two-way communication, and Secure Communications for fully controlled customer environments."
>
  <main class="sp-home">

    <section class="sp-hero sp-portfolio-hero">
      <div class="sp-container sp-portfolio-hero__grid">
        <div>
          <p class="sp-kicker">StayPrivate</p>
          <h1>Secure communication between businesses and their customers</h1>
          <p class="sp-hero-intro">
            StayPrivate provides products for delivering important documents,
            communicating privately with customers and operating fully controlled
            secure customer environments.
          </p>
        </div>

        <div class="sp-portfolio-summary" aria-label="StayPrivate products">
          <p class="sp-portfolio-summary__title">Choose the right communication model</p>

          <a href="https://documentd.com" class="sp-portfolio-summary__item">
            <p class="sp-portfolio-summary__eyebrow">Deliver</p>
            <div class="sp-portfolio-summary__brand">
              <img src="./images/Documentd-Mark.svg" alt="" aria-hidden="true" />
              <strong>Documentd</strong>
            </div>
            <p class="sp-portfolio-summary__copy">Give customers their own copy of important documents.</p>
          </a>

          <a href={spmHref} class="sp-portfolio-summary__item">
            <p class="sp-portfolio-summary__eyebrow">Communicate</p>
            <div class="sp-portfolio-summary__brand">
              <img src="./images/Documentd-Mark.svg" alt="" aria-hidden="true" />
              <strong>StayPrivateMail</strong>
            </div>
            <p class="sp-portfolio-summary__copy">Exchange private messages and files in an ongoing relationship.</p>
          </a>

          <a href={secureCommHref} class="sp-portfolio-summary__item">
            <p class="sp-portfolio-summary__eyebrow">Control</p>
            <div class="sp-portfolio-summary__brand">
              <img src="./images/Documentd-Mark.svg" alt="" aria-hidden="true" />
              <strong>Secure Communications</strong>
            </div>
            <p class="sp-portfolio-summary__copy">Operate a secure customer environment owned by your organisation.</p>
          </a>
        </div>
      </div>
    </section>

    <section id="products" class="sp-products-section">
      <div class="sp-container">
        <div class="sp-section-heading">
          <p class="sp-kicker">Business products</p>
          <h2>Three different ways to communicate securely</h2>
          <p>
            Choose the model that matches the relationship you want with your
            customers, from straightforward document delivery to a completely
            controlled communications environment.
          </p>
        </div>

        <div class="sp-product-grid">
          <a href="https://documentd.com" class="sp-product-tile sp-product-tile--documentd">
            <div class="sp-card-brand">
              <img src="./images/Documentd-Mark.svg" alt="" aria-hidden="true" class="sp-card-brand-icon" />
              <span class="sp-card-brand-name">Documentd</span>
            </div>
            <p class="sp-product-tile__eyebrow">Deliver</p>
            <h3>Deliver important documents</h3>
            <p>
              Give customers their own copy of important documents to keep, without
              replacing your existing email, portal or customer systems.
            </p>
            <strong>Explore Documentd <span>→</span></strong>
          </a>

          <a href={spmHref} class="sp-product-tile sp-product-tile--spm">
            <div class="sp-card-brand">
              <img src="./images/Documentd-Mark.svg" alt="" aria-hidden="true" class="sp-card-brand-icon" />
              <span class="sp-card-brand-name">StayPrivateMail</span>
            </div>
            <p class="sp-product-tile__eyebrow">Communicate</p>
            <h3>Private communication and file sharing</h3>
            <p>
              Give businesses and customers a private way to exchange messages and
              files, with customers receiving their own Keepd account.
            </p>
            <strong>Explore StayPrivateMail <span>→</span></strong>
          </a>

          <a href={secureCommHref} class="sp-product-tile sp-product-tile--secure">
            <div class="sp-card-brand">
              <img src="./images/Documentd-Mark.svg" alt="" aria-hidden="true" class="sp-card-brand-icon" />
              <span class="sp-card-brand-name">StayPrivate Secure Communications</span>
            </div>
            <p class="sp-product-tile__eyebrow">Control</p>
            <h3>Your own secure customer environment</h3>
            <p>
              A dedicated secure communications platform in which your organisation
              controls the environment, access, information and customer experience.
            </p>
            <strong>Explore Secure Communications <span>→</span></strong>
          </a>
        </div>
      </div>
    </section>

    <section class="sp-choice-section">
      <div class="sp-container sp-choice-grid">
        <div>
          <p class="sp-kicker">Different models, one purpose</p>
          <h2>The right level of control depends on the communication</h2>
        </div>

        <div class="sp-choice-list">
          <div>
            <strong>Documentd</strong>
            <p>
              Best when the business wants to deliver something important and the
              customer should own their copy independently afterwards.
            </p>
          </div>
          <div>
            <strong>StayPrivateMail</strong>
            <p>
              Best when the relationship is ongoing and both sides need to exchange
              private messages and files, while the customer retains their own Keepd.
            </p>
          </div>
          <div>
            <strong>Secure Communications</strong>
            <p>
              Best when the organisation needs to own and control the whole secure
              environment, including access, information and the customer experience.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="sp-keepd-section">
      <div class="sp-container sp-keepd-grid">
        <div>
          <p class="sp-kicker">For the customer</p>
          <div class="sp-card-brand sp-keepd-brand">
            <img src="./images/Keepd-Mark.svg" alt="" aria-hidden="true" class="sp-card-brand-icon" />
            <span class="sp-card-brand-name">Keepd</span>
          </div>
          <h2>A private place for the person receiving the information</h2>
        </div>

        <div class="sp-keepd-copy">
          <p>
            Keepd is not a business product we sell. It is the customer-facing
            environment used by Documentd and StayPrivateMail, giving individuals
            their own private account for information they receive and keep.
          </p>
          <p>
            That is deliberately different from StayPrivate Secure Communications,
            where the organisation controls the environment rather than the customer.
          </p>
          <a href="https://keepd.com" class="sp-text-link">Explore Keepd <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="sp-secondary-section">
      <div class="sp-container sp-secondary-grid">
        <div>
          <p class="sp-kicker">Bespoke</p>
          <h2>When a standard product is not quite the right fit</h2>
        </div>
        <div>
          <p>
            We can adapt and integrate StayPrivate technology around existing
            systems, specialist workflows and unusual communication requirements.
          </p>
          <a href={bespokeHref} class="sp-text-link">Explore Bespoke <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="sp-home-contact">
      <div class="sp-container sp-home-contact-inner">
        <div>
          <p class="sp-kicker">StayPrivate</p>
          <h2>Which communication model fits your organisation?</h2>
          <p>
            Talk to us about Documentd, StayPrivateMail, Secure Communications or a
            specialist requirement that needs a more tailored approach.
          </p>
        </div>
        <a href={contactHref} class="sp-home-contact-cta">Contact us <span>→</span></a>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .sp-portfolio-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .sp-hero-support {
    max-width: 720px;
    margin: 1.25rem 0 0;
    color: var(--sp-muted);
    font-size: 1rem;
    line-height: 1.75;
  }

  .sp-portfolio-summary {
    overflow: hidden;
    border: 1px solid var(--sp-border);
    border-radius: 28px;
    background: rgba(255,255,255,.92);
    box-shadow: 0 28px 70px rgba(32, 36, 79, 0.1);
  }

  .sp-portfolio-summary__title {
    margin: 0;
    padding: 1.25rem 1.7rem 1.1rem;
    border-bottom: 1px solid var(--sp-border);
    color: var(--sp-muted);
    font-family: Poppins, sans-serif;
    font-size: .82rem;
    font-weight: 600;
  }

  .sp-portfolio-summary__item {
    display: block;
    padding: 1.35rem 1.7rem 1.45rem;
    color: inherit;
    text-decoration: none;
    transition: background .2s ease;
  }

  .sp-portfolio-summary__item + .sp-portfolio-summary__item {
    border-top: 1px solid var(--sp-border);
  }

  .sp-portfolio-summary__item:hover {
    background: rgba(247,248,253,.9);
  }

  .sp-portfolio-summary__eyebrow {
    margin: 0 0 .45rem;
    color: var(--sp-blue);
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .sp-portfolio-summary__brand {
    display: flex;
    align-items: center;
    gap: .6rem;
  }

  .sp-portfolio-summary__brand img {
    width: 22px;
    height: 22px;
    object-fit: contain;
    flex: 0 0 auto;
  }

  .sp-portfolio-summary__brand strong {
    color: var(--sp-ink);
    font-family: Poppins, sans-serif;
    font-size: 1rem;
  }

  .sp-portfolio-summary__copy {
    margin: .45rem 0 0 2.6rem;
    color: var(--sp-muted);
    line-height: 1.55;
  }

  .sp-products-section,
  .sp-choice-section,
  .sp-keepd-section,
  .sp-secondary-section { padding-block: clamp(5rem, 8vw, 8rem); }

  .sp-section-heading { max-width: 820px; margin: 0 auto; text-align: center; }
  .sp-section-heading h2,
  .sp-choice-grid h2,
  .sp-keepd-grid h2,
  .sp-secondary-grid h2 {
    margin: .5rem 0 1rem;
    color: var(--sp-ink);
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 1.12;
    letter-spacing: -.04em;
  }
  .sp-section-heading > p:last-child { margin: 0; color: var(--sp-muted); font-size: 1.05rem; line-height: 1.75; }

  .sp-product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: clamp(2.75rem, 5vw, 4.5rem);
  }

  .sp-product-tile {
    display: flex;
    min-height: 430px;
    flex-direction: column;
    padding: clamp(1.6rem, 3vw, 2.2rem);
    border: 1px solid var(--sp-border);
    border-radius: 26px;
    background: rgba(255,255,255,.88);
    box-shadow: 0 20px 50px rgba(32,36,79,.07);
    text-decoration: none;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .sp-product-tile:hover { transform: translateY(-5px); box-shadow: 0 28px 65px rgba(32,36,79,.12); }
  .sp-product-tile__brand { min-height: 38px; margin: 0 0 14px; color: var(--sp-ink); font-family: Poppins, sans-serif; font-size: 1rem; font-weight: 700; }
  .sp-product-tile__eyebrow { margin: .3rem 0 .75rem; color: var(--sp-blue); font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .sp-product-tile h3 { margin: 0 0 1rem; color: var(--sp-ink); font-size: 1.65rem; line-height: 1.18; letter-spacing: -.035em; }
  .sp-product-tile > p:not(.sp-product-tile__brand):not(.sp-product-tile__eyebrow) { margin: 0; color: var(--sp-muted); line-height: 1.7; }
  .sp-product-tile > strong { margin-top: auto; padding-top: 2rem; color: var(--sp-blue); font-family: Poppins, sans-serif; font-size: .9rem; }

  .sp-choice-section { background: rgba(255,255,255,.65); }
  .sp-choice-grid,
  .sp-keepd-grid,
  .sp-secondary-grid { display: grid; grid-template-columns: minmax(0,.85fr) minmax(0,1.15fr); gap: clamp(3rem, 7vw, 7rem); align-items: start; }
  .sp-choice-list { display: grid; gap: 1px; overflow: hidden; border: 1px solid var(--sp-border); border-radius: 24px; background: var(--sp-border); }
  .sp-choice-list > div { padding: 1.5rem 1.7rem; background: #fff; }
  .sp-choice-list strong { color: var(--sp-ink); font-family: Poppins, sans-serif; }
  .sp-choice-list p,
  .sp-keepd-copy p,
  .sp-secondary-grid > div:last-child p { margin: .55rem 0 0; color: var(--sp-muted); line-height: 1.75; }

  .sp-keepd-section { background: linear-gradient(135deg, rgba(83,21,145,.07), rgba(26,71,214,.04)); }
  .sp-keepd-brand { margin: 1.25rem 0 .3rem; }
  .sp-keepd-copy { padding-top: 2rem; }
  .sp-text-link { display: inline-flex; gap: .5rem; margin-top: 1.25rem; color: var(--sp-blue); font-family: Poppins, sans-serif; font-weight: 600; text-decoration: none; }

  @media (max-width: 900px) {
    .sp-portfolio-hero__grid,
    .sp-choice-grid,
    .sp-keepd-grid,
    .sp-secondary-grid { grid-template-columns: 1fr; }
    .sp-product-grid { grid-template-columns: 1fr; }
    .sp-product-tile { min-height: 0; }
  }
</style>
