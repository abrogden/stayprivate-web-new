---
import { withBase } from "../lib/paths";

const homeHref = withBase("/");
const productsHref = withBase("/#products");
const aboutHref = withBase("/about");
const trustHref = withBase("/trust");
const contactHref = withBase("/contact");
const logoSrc = withBase("/images/StayPrivate-Logo.svg");
---

<header class="sp-header">
  <div class="sp-container sp-header-inner">
    <a href={homeHref} class="sp-logo" aria-label="StayPrivate home">
      <img
        src={logoSrc}
        alt="StayPrivate"
        class="sp-logo-image"
      />
    </a>

    <nav class="sp-nav" aria-label="Main navigation">
      <a href={productsHref}>Products</a>
      <a href={aboutHref}>About</a>
      <a href={trustHref}>Trust</a>
      <a href={contactHref}>Contact</a>
    </nav>

    <a
      href="https://admin.stayprivate.com"
      target="_blank"
      rel="noopener noreferrer"
      class="sp-header-btn"
    >
      Admin Portal
    </a>
  </div>
</header>
