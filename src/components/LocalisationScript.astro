  function getTrackingPath() {
    let pathname = window.location.pathname;

    if (pathname === "/" && window.location.origin === "https://keepd.com") {
      pathname = "keepd";
    }

    pathname = pathname.replaceAll("/", "_");

    const query = window.location.search.replaceAll("?", "");

    if (query !== "") {
      pathname = `${pathname}&${query}`;
    }

    return pathname;
  }

  function applyCurrency(currency) {
    const locale = LOCALISATION[currency] || LOCALISATION.GBP;

    document.documentElement.dataset.currency = locale.currency;

    document.querySelectorAll("[data-price]").forEach((node) => {
      const key = node.dataset.price;

      if (locale.prices[key]) {
        node.textContent = locale.prices[key];
      }
    });

    window.dispatchEvent(
      new CustomEvent("sp:currency-ready", {
        detail: locale,
      })
    );
  }

  function applyWords(currency) {
    const locale = LOCALISATION[currency] || LOCALISATION.GBP;

    //const locale = LOCALISATION.USD;

    document.documentElement.dataset.country = locale.country;

    document.querySelectorAll("[data-word]").forEach((node) => {
      const key = node.dataset.word;

      if (locale.words[key]) {
        node.textContent = locale.words[key];
      }
    });

    document.querySelectorAll("[data-location-field]").forEach((field) => {
      field.value = locale.country;
    });

    window.dispatchEvent(
      new CustomEvent("sp:words-ready", {
        detail: locale,
      })
    );
  }

  async function loadLocalisation() {
    applyCurrency("GBP");
    applyWords("GBP");

    try {
      const path = encodeURIComponent(getTrackingPath());

      const response = await fetch(
        `https://services2.stayprivate.com/utils/localdata?path=${path}`
      );

      if (!response.ok) return;

      const data = await response.json();
      const detectedCurrency = data.country_currency || "GBP";

      applyCurrency(detectedCurrency);
      applyWords(detectedCurrency);
    } catch (error) {
      console.warn("Localisation unavailable; using GBP defaults.", error);
    }
  }

  window.setStayPrivateCurrency = applyCurrency;

  loadLocalisation();
